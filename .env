SECRET_KEY=django-insecure-cse-smartroom-module1-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration via Environment Variables
# To connect to PostgreSQL set USE_POSTGRES=True and configure credentials
USE_POSTGRES=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=csesmartroom
DB_USER=smartroom_user
DB_PASSWORD=smartroom_password
DB_HOST=localhost
DB_PORT=5432
